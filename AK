function rank(xp){return xp>=2000?'Forest Guardian':xp>=800?'Trailblazer':xp>=300?'Naturalist':xp>=100?'Sprout Scout':'Seedling'}
function rarityFor(taxon){/* Game-only award; deterministic for a species, not ecological rarity. */const id=Number(taxon.id)||0;const n=(Math.imul(id,2654435761)>>>0)%100;return n<4?['Epic',100]:n<17?['Rare',60]:n<43?['Uncommon',30]:['Common',10]}
function updateStats(){const xp=collection.reduce((a,b)=>a+(Number(b.xp)||0),0);$('speciesCount').textContent=new Set(collection.map(x=>x.id)).size;$('xpCount').textContent=xp.toLocaleString();$('rankCount').textContent=rank(xp);$('collectionSummary').textContent=`${collection.length} ${collection.length===1?'discovery':'discoveries'}`;$('collectionXP').textContent=`${xp} XP earned`}
function renderCollection(){updateStats();const grid=$('collectionGrid');grid.replaceChildren();$('emptyCollection').hidden=collection.length>0;collection.slice().reverse().forEach(item=>{const card=document.createElement('article');card.className='species-card';const img=document.createElement('img');img.src=item.image||placeholder;img.alt=item.common||item.scientific;img.onerror=()=>{img.onerror=null;img.src=placeholder};card.append(img);const box=document.createElement('div');box.className='species-info';const title=document.createElement('h3');title.textContent=item.common||item.scientific;const latin=document.createElement('i');latin.textContent=item.scientific||'';const date=document.createElement('p');date.textContent=`Found ${new Date(item.date).toLocaleDateString()}${item.notes?' · '+item.notes:''}`;const meta=document.createElement('div');meta.className='species-meta';const rarity=document.createElement('span');rarity.className='rarity '+item.rarity.toLowerCase();rarity.textContent=item.rarity+' (game)';const xp=document.createElement('strong');xp.textContent='+'+item.xp+' XP';meta.append(rarity,xp);const del=document.createElement('button');del.className='delete-button';del.textContent='Remove discovery';del.addEventListener('click',()=>{if(confirm('Remove this discovery from your collection?')){collection=collection.filter(x=>x.key!==item.key);persist();renderCollection()}});box.append(title,latin,date,meta,del);card.append(box);grid.append(card)})}
function persist(){try{localStorage.setItem(STORE,JSON.stringify(collection));return true}catch(e){notify('Storage is full or unavailable. Try using a smaller photo.');return false}}
function route(){const name=(location.hash||'#home').slice(1);const allowed=['home','identify','collection','fieldguide','about'];const route=allowed.includes(name)?name:'home';document.querySelectorAll('.page').forEach(p=>p.classList.toggle('shown',p.id===route));document.querySelectorAll('[data-nav]').forEach(a=>a.classList.toggle('active',a.dataset.nav===route));$('pageLabel').textContent=({home:'Overview',identify:'Identify a species',collection:'My collection',fieldguide:'Field guide',about:'About APLI'})[route];if(route==='collection')renderCollection();window.scrollTo(0,0)}window.addEventListener('hashchange',route);
function makeThumb(file){return new Promise((resolve,reject)=>{const reader=new FileReader();reader.onerror=()=>reject(new Error('Cannot open photo'));reader.onload=()=>{const img=new Image();img.onerror=()=>reject(new Error('Unsupported photo format'));img.onload=()=>{const max=900,scale=Math.min(1,max/Math.max(img.width,img.height));const canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(img.width*scale));canvas.height=Math.max(1,Math.round(img.height*scale));canvas.getContext('2d').drawImage(img,0,0,canvas.width,canvas.height);resolve(canvas.toDataURL('image/jpeg',.76))};img.src=reader.result};reader.readAsDataURL(file)})}
async function loadPhoto(file){if(!file)return;if(!file.type.startsWith('image/')){notify('Please select an image file.');return}if(file.size>20*1024*1024){notify('Photo is too large (maximum 20 MB).');return}try{imageData=await makeThumb(file);$('preview').src=imageData;$('preview').hidden=false;$('uploadPlaceholder').hidden=true;$('analyzeBtn').disabled=false;$('guesses').replaceChildren();$('analysisStatus').textContent='Photo ready. Select “Analyze photo” for an experimental AI clue, or search the species by name.'}catch(e){notify(e.message)}}
$('photo').addEventListener('change',e=>loadPhoto(e.target.files[0]));const drop=$('dropZone');drop.addEventListener('dragover',e=>{e.preventDefault();drop.style.borderColor='#347d55'});drop.addEventListener('dragleave',()=>drop.style.borderColor='');drop.addEventListener('drop',e=>{e.preventDefault();drop.style.borderColor='';loadPhoto(e.dataTransfer.files[0])});
$('analyzeBtn').addEventListener('click',async()=>{if(!imageData||analysisBusy)return;analysisBusy=true;$('analyzeBtn').disabled=true;$('analysisStatus').textContent='Loading image recognition model and analyzing your photo… (first use requires internet)';$('guesses').replaceChildren();try{if(!window.tf||!window.mobilenet)throw Error('Image recognition library could not load.');if(!modelPromise)modelPromise=window.mobilenet.load({version:2,alpha:0.5});const model=await modelPromise;const img=$('preview');if(!img.complete)await new Promise((r,j)=>{img.onload=r;img.onerror=j});const predictions=await model.classify(img,3);$('analysisStatus').textContent='Possible general image labels (not verified species identification):';predictions.forEach(p=>{const d=document.createElement('div');d.className='guess';d.textContent=p.className;const conf=document.createElement('small');conf.textContent=Math.round(p.probability*100)+'% model confidence';d.append(conf);$('guesses').append(d)})}catch(e){modelPromise=null;$('analysisStatus').textContent='AI hints are unavailable. You can still search and manually verify the species below.';notify('AI model unavailable; manual species search still works.')}finally{analysisBusy=false;$('analyzeBtn').disabled=false}});
async function taxaSearch(query){const url='https://api.inaturalist.org/v1/taxa/autocomplete?q='+encodeURIComponent(query)+'&per_page=8';const res=await fetch(url);if(!res.ok)throw Error('Species search is unavailable');const data=await res.json();return data.results||[]}
function taxonPhoto(t){return t.default_photo?.medium_url||t.default_photo?.square_url||''}
function taxonName(t){return t.preferred_common_name||t.name}
function renderSuggestion(parent,t,onChoose,kind){const row=document.createElement(kind==='button'?'button':'div');row.className=kind==='button'?'suggestion':'guide-result';if(kind==='button'){row.type='button';row.style.width='100%';row.style.textAlign='left';row.style.border='0';row.style.background='transparent';row.style.borderBottom='1px solid #eef0eb'}const photo=document.createElement('img');photo.src=taxonPhoto(t)||placeholder;photo.alt='';photo.loading='lazy';const info=document.createElement('div');const title=document.createElement('strong');title.textContent=taxonName(t);const latin=document.createElement('small');latin.textContent=t.name+(t.rank?' · '+t.rank:'');info.append(title,latin);row.append(photo,info);if(onChoose)row.addEventListener('click',()=>onChoose(t));parent.append(row)}
$('speciesSearch').addEventListener('input',e=>{const q=e.target.value.trim();clearTimeout(searchTimer);currentTaxon=null;$('saveBtn').disabled=true;$('selectedSpecies').hidden=true;$('suggestions').replaceChildren();if(q.length<2)return;searchTimer=setTimeout(async()=>{try{const results=await taxaSearch(q);if($('speciesSearch').value.trim()!==q)return;const el=$('suggestions');el.replaceChildren();if(!results.length){el.textContent='No results found. Try a different name.';return}results.forEach(t=>renderSuggestion(el,t,selectTaxon,'button'))}catch{$('suggestions').textContent='Cannot connect to species search. Check your internet connection.'}},300)});
function selectTaxon(t){currentTaxon=t;$('speciesSearch').value=taxonName(t);$('suggestions').replaceChildren();const el=$('selectedSpecies');el.replaceChildren();const img=document.createElement('img');img.src=taxonPhoto(t)||placeholder;img.alt='';const info=document.createElement('div');const title=document.createElement('strong');title.textContent=taxonName(t);const detail=document.createElement('small');detail.textContent=t.name+' · selected species';info.append(title,detail);el.append(img,info);el.hidden=false;$('saveBtn').disabled=false}
$('saveBtn').addEventListener('click',()=>{if(!currentTaxon){notify('Choose a species from the search results first.');return}const [rarity,xp]=rarityFor(currentTaxon);const item={key:crypto.randomUUID?.()||Date.now()+'-'+Math.random(),id:currentTaxon.id,common:taxonName(currentTaxon),scientific:currentTaxon.name,rarity,xp,image:imageData||taxonPhoto(currentTaxon)||'',notes:$('notes').value.trim().slice(0,400),date:new Date().toISOString()};collection.push(item);if(!persist()){collection.pop();return}notify(`Discovery saved! +${xp} XP (${rarity} game reward)`);imageData='';currentTaxon=null;$('photo').value='';$('preview').hidden=true;$('preview').removeAttribute('src');$('uploadPlaceholder').hidden=false;$('speciesSearch').value='';$('selectedSpecies').hidden=true;$('notes').value='';$('analysisStatus').textContent='Add a photo to see possible image labels here.';$('guesses').replaceChildren();$('analyzeBtn').disabled=true;$('saveBtn').disabled=true;location.hash='#collection';renderCollection()});
$('guideSearch').addEventListener('input',e=>{const q=e.target.value.trim();clearTimeout(guideTimer);$('guideResults').replaceChildren();if(q.length<2)return;guideTimer=setTimeout(async()=>{try{const data=await taxaSearch(q);if($('guideSearch').value.trim()!==q)return;const el=$('guideResults');el.replaceChildren();if(!data.length){el.textContent='No matches found.';return}data.forEach(t=>renderSuggestion(el,t,null,'div'))}catch{$('guideResults').textContent='Search unavailable. Check your internet connection.'}},300)});
$('exportBtn').addEventListener('click',()=>{const blob=new Blob([JSON.stringify({app:'APLI',exportedAt:new Date().toISOString(),discoveries:collection},null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='apli-collection.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);notify('Collection exported to a JSON file.')});
renderCollection();route();

</script></body></html>
